# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
# The site is built and deployed by GitHub Actions, so dist/ is never committed.
dist/
*.tsbuildinfo

# `tsc -b` also compiles vite.config.ts next to itself; these are leftovers.
vite.config.js
vite.config.d.ts

# ── Caches ────────────────────────────────────────────────────
.vite/
.cache/
.eslintcache

# ── Environment variables ─────────────────────────────────────
# .env.production is tracked on purpose: it only holds public build-time URLs (VITE_*).
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Editors and local tools ───────────────────────────────────
# Keep shared VS Code settings; ignore the rest.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# Claude Code local settings
.claude/

# Local REST client scratch file
api.http

# ── Operating system ──────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporary files ───────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*.bak
