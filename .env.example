# ── Frontend (Vite, read at build time) ───────────────────────────────
# Base URL of the deployed RMP proxy, including the /api/rmp path.
# Leave unset in dev: requests go to /api/rmp and Vite proxies them to localhost:3001.
# If unset in a production build, the Instructor Ratings section is hidden.
VITE_RMP_API_URL=https://your-service-name.onrender.com/api/rmp

# Google Apps Script web app /exec URL for the "Report bug" button (see apps-script/bugReport.gs).
# If unset, the button is hidden.
VITE_BUG_REPORT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# ── Server (server/index.js) ───────────────────────────────────────────
# Comma-separated list of extra origins allowed by CORS (http://localhost:5173 is always allowed).
# Origins have no path: use https://<user>.github.io, not .../MSE-Course-Planner/.
ALLOWED_ORIGINS=https://jsdhillon8.github.io
# Port for the server (Render sets this automatically). Defaults to 3001.
PORT=3001
